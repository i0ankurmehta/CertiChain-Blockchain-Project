{
  "study": "EACT-B3",
  "title": "Provenance and freshness assessment",
  "note": "Synthetic research fixtures. Freshness thresholds are experimental parameters: 90 days for issuer-authentication evidence and 24 hours for credential-status evidence. These are not universal standards.",
  "scenarios": [
    {
      "id": "B3-01",
      "title": "Fresh authenticated issuer reports revoked status",
      "description": "Positive provenance case with a current authenticated revoked-status response.",
      "integrity_result": "match",
      "reference_origin": "issuer_signed_manifest",
      "reference_signature_status": "verified",
      "issuer_authentication_status": "authenticated",
      "issuer_auth_source": "trusted_issuer_directory",
      "issuer_auth_age_days": 2,
      "credential_status": "revoked",
      "status_source_type": "issuer_status_api",
      "status_source_authentication": "authenticated",
      "status_checked_age_hours": 1,
      "expected_disposition": "credential_status_revoked_confirmed"
    },
    {
      "id": "B3-02",
      "title": "Previously authenticated issuer evidence is stale",
      "description": "Issuer was authenticated 180 days ago, beyond the 90-day experimental threshold.",
      "integrity_result": "match",
      "reference_origin": "issuer_signed_manifest",
      "reference_signature_status": "verified",
      "issuer_authentication_status": "authenticated",
      "issuer_auth_source": "trusted_issuer_directory",
      "issuer_auth_age_days": 180,
      "credential_status": "active",
      "status_source_type": "issuer_status_api",
      "status_source_authentication": "authenticated",
      "status_checked_age_hours": 1,
      "expected_disposition": "issuer_authentication_stale"
    },
    {
      "id": "B3-03",
      "title": "Hash matches but reference origin is unknown",
      "description": "The digest comparison matches, but nobody can establish the source of the reference hash.",
      "integrity_result": "match",
      "reference_origin": "unknown",
      "reference_signature_status": "not_checked",
      "issuer_authentication_status": "authenticated",
      "issuer_auth_source": "trusted_issuer_directory",
      "issuer_auth_age_days": 2,
      "credential_status": "active",
      "status_source_type": "issuer_status_api",
      "status_source_authentication": "authenticated",
      "status_checked_age_hours": 1,
      "expected_disposition": "reference_provenance_unverified"
    },
    {
      "id": "B3-04",
      "title": "Credential status snapshot is stale",
      "description": "Status was checked 45 days ago; issuer authentication and reference provenance are current.",
      "integrity_result": "match",
      "reference_origin": "trusted_registry_export",
      "reference_signature_status": "verified",
      "issuer_authentication_status": "authenticated",
      "issuer_auth_source": "trusted_issuer_directory",
      "issuer_auth_age_days": 4,
      "credential_status": "active",
      "status_source_type": "signed_registry_snapshot",
      "status_source_authentication": "authenticated",
      "status_checked_age_hours": 1080,
      "expected_disposition": "status_evidence_stale"
    },
    {
      "id": "B3-05",
      "title": "Reference signature is invalid",
      "description": "The reference source claims to be a signed issuer manifest, but signature verification failed.",
      "integrity_result": "match",
      "reference_origin": "issuer_signed_manifest",
      "reference_signature_status": "invalid",
      "issuer_authentication_status": "authenticated",
      "issuer_auth_source": "trusted_issuer_directory",
      "issuer_auth_age_days": 2,
      "credential_status": "active",
      "status_source_type": "issuer_status_api",
      "status_source_authentication": "authenticated",
      "status_checked_age_hours": 1,
      "expected_disposition": "reference_signature_invalid"
    },
    {
      "id": "B3-06",
      "title": "Untrusted status source claims credential revoked",
      "description": "A manual status claim says revoked, but the source is not authenticated.",
      "integrity_result": "match",
      "reference_origin": "issuer_signed_manifest",
      "reference_signature_status": "verified",
      "issuer_authentication_status": "authenticated",
      "issuer_auth_source": "trusted_issuer_directory",
      "issuer_auth_age_days": 3,
      "credential_status": "revoked",
      "status_source_type": "manual_claim",
      "status_source_authentication": "unverified",
      "status_checked_age_hours": 1,
      "expected_disposition": "status_source_untrusted"
    },
    {
      "id": "B3-07",
      "title": "Issuer authentication timestamp is missing",
      "description": "Issuer identity is reported as authenticated, but the authentication event timestamp is unavailable.",
      "integrity_result": "match",
      "reference_origin": "trusted_registry_export",
      "reference_signature_status": "verified",
      "issuer_authentication_status": "authenticated",
      "issuer_auth_source": "trusted_issuer_directory",
      "issuer_auth_age_days": null,
      "credential_status": "active",
      "status_source_type": "issuer_status_api",
      "status_source_authentication": "authenticated",
      "status_checked_age_hours": 2,
      "expected_disposition": "issuer_authentication_timestamp_missing"
    },
    {
      "id": "B3-08",
      "title": "All evidence is current and authenticated",
      "description": "Positive control: reference, issuer authentication and status evidence satisfy configured rules.",
      "integrity_result": "match",
      "reference_origin": "issuer_signed_manifest",
      "reference_signature_status": "verified",
      "issuer_authentication_status": "authenticated",
      "issuer_auth_source": "trusted_issuer_directory",
      "issuer_auth_age_days": 1,
      "credential_status": "active",
      "status_source_type": "issuer_status_api",
      "status_source_authentication": "authenticated",
      "status_checked_age_hours": 0.5,
      "expected_disposition": "provenance_and_freshness_current"
    },
    {
      "id": "B3-09",
      "title": "Integrity mismatch against trusted signed reference",
      "description": "The reference source and signature are trusted, and the document comparison reports a mismatch.",
      "integrity_result": "mismatch",
      "reference_origin": "trusted_registry_export",
      "reference_signature_status": "verified",
      "issuer_authentication_status": "authenticated",
      "issuer_auth_source": "trusted_issuer_directory",
      "issuer_auth_age_days": 2,
      "credential_status": "active",
      "status_source_type": "issuer_status_api",
      "status_source_authentication": "authenticated",
      "status_checked_age_hours": 1,
      "expected_disposition": "integrity_mismatch_confirmed"
    },
    {
      "id": "B3-10",
      "title": "Issuer and status evidence are both stale",
      "description": "Issuer authentication is 180 days old and the status snapshot is 72 hours old.",
      "integrity_result": "match",
      "reference_origin": "issuer_signed_manifest",
      "reference_signature_status": "verified",
      "issuer_authentication_status": "authenticated",
      "issuer_auth_source": "trusted_issuer_directory",
      "issuer_auth_age_days": 180,
      "credential_status": "active",
      "status_source_type": "signed_registry_snapshot",
      "status_source_authentication": "authenticated",
      "status_checked_age_hours": 72,
      "expected_disposition": "issuer_authentication_stale"
    }
  ]
}
